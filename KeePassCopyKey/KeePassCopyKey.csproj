<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Zero PackageReference / native DLL rule (same as keepasshttp2's own
    plugin project - see that project's .csproj for the full rationale).
    Shared properties (TargetFramework, Deterministic,
    ContinuousIntegrationBuild, PathMap, KeePassDir) come from
    ../Directory.Build.props.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>KeePassCopyKey</RootNamespace>
    <AssemblyName>KeePassCopyKey</AssemblyName>
  </PropertyGroup>

  <!--
    Version stamping for releases. AssemblyVersion is kept fixed at the
    major.minor.0.0 level (changing it breaks binding for anything that
    referenced the old one, not a concern for a plugin with no external
    consumers, but keeping the habit anyway) - FileVersion and
    InformationalVersion carry the actual release number shown to users
    (Tools > About, file Properties in Explorer).
  -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>KeePass Plugin</Product>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="KeePass">
      <HintPath>$(KeePassDir)\KeePass.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>